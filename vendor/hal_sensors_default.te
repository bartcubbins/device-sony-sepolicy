# interact with the sensors low power island (SLPI) CPU
qrtr_socket_create(hal_sensors_default)

rw_vendor_diag_device(hal_sensors_default)

r_dir_file(hal_sensors_default, vendor_sysfs_msm_subsys);
allow hal_sensors_default vendor_sysfs_esoc:dir r_dir_perms;

# read and write factory calibration and sensor configuration data
allow hal_sensors_default mnt_vendor_file:dir search;
allow hal_sensors_default vendor_persist_file:dir search;
allow hal_sensors_default vendor_persist_sensors_file:dir create_dir_perms;
allow hal_sensors_default vendor_persist_sensors_file:file create_file_perms;

dontaudit hal_sensors_default kernel:system module_request;
