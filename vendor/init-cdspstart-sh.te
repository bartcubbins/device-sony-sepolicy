type vendor_init-qcom-cdspstart-sh, domain;
type vendor_init-qcom-cdspstart-sh_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_init-qcom-cdspstart-sh)

allow vendor_init-qcom-cdspstart-sh { vendor_file vendor_shell_exec vendor_toolbox_exec }:file rx_file_perms;

# Set the vendor.qcom.cdspup property
set_prop(vendor_init-qcom-cdspstart-sh, vendor_device_prop)

# Set boot_cdsp to 1
allow vendor_init-qcom-cdspstart-sh vendor_sysfs_boot_cdsp:file w_file_perms;

# Access to remoteproc name/status
r_dir_file(vendor_init-qcom-cdspstart-sh, vendor_sysfs_ssr)
