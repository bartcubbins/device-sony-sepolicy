# Ucomm Server
# Used by the Xperia Touch "blanc" projector, loire platform
# Controls the ToF sensor, communicates over sockets
type vendor_ucommsvr, domain;
type vendor_ucommsvr_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_ucommsvr)

# For dropping permissions
allow vendor_ucommsvr self:capability { chown setuid };

allow vendor_ucommsvr vendor_ucommsvr_socket:dir rw_dir_perms;
allow vendor_ucommsvr vendor_ucommsvr_socket:sock_file create_file_perms;

allow vendor_ucommsvr serial_device:chr_file rw_file_perms;

allow vendor_ucommsvr input_device:dir search;
allow vendor_ucommsvr input_device:chr_file r_file_perms;

allow vendor_ucommsvr vendor_sysfs_input_name:file r_file_perms;
allow vendor_ucommsvr vendor_sysfs_input_control:file { rw_file_perms setattr };
allow vendor_ucommsvr vendor_sysfs_tof_sensor:file { rw_file_perms setattr };

# Ignore overzealous probing
dontaudit vendor_ucommsvr vendor_sysfs_msm_subsys:dir r_dir_perms;
dontaudit vendor_ucommsvr vendor_sysfs_msm_subsys:file r_file_perms;
dontaudit vendor_ucommsvr sysfs:dir r_dir_perms;
dontaudit vendor_ucommsvr sysfs:file r_file_perms;
