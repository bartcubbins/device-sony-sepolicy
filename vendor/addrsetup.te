type vendor_addrsetup, domain;
type vendor_addrsetup_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_addrsetup)

unix_socket_connect(vendor_addrsetup, vendor_tad, tad)

allow vendor_addrsetup vendor_bluetooth_data_file:dir rw_dir_perms;
allow vendor_addrsetup vendor_bluetooth_data_file:file create_file_perms;

allow vendor_addrsetup vendor_wifi_data_file:dir rw_dir_perms;
allow vendor_addrsetup vendor_wifi_data_file:file create_file_perms;

allow vendor_addrsetup hostapd_data_file:dir rw_dir_perms;
allow vendor_addrsetup hostapd_data_file:file create_file_perms;

allow vendor_addrsetup wpa_data_file:dir rw_dir_perms;
allow vendor_addrsetup wpa_data_file:file create_file_perms;

allow vendor_addrsetup vendor_sysfs_addrsetup:file rw_file_perms;

allow vendor_addrsetup self:capability { net_admin net_raw };
allow vendor_addrsetup self:udp_socket { create ioctl };
# If compiled with BRCFMAC:
allowxperm vendor_addrsetup self:udp_socket ioctl SIOCSIFHWADDR;

dontaudit vendor_addrsetup kernel:system module_request;
