# CASH - Camera Augmented Sensing Helper - Server part
# Controls the ToF and RGBCIR sensors on loire platform and newer
# Communicates with the camera HAL over sockets
type vendor_cashsvr, domain;
type vendor_cashsvr_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_cashsvr)

# For dropping permissions
allow vendor_cashsvr self:capability { chown setuid };

# Read persist.vendor.cash.*
get_prop(vendor_cashsvr, vendor_cash_prop)

# Connect to the tad daemon by using libta.so
unix_socket_connect(vendor_cashsvr, vendor_tad, tad)

allow vendor_cashsvr vendor_cashsvr_socket:dir rw_dir_perms;
allow vendor_cashsvr vendor_cashsvr_socket:sock_file create_file_perms;

# Write calibrations to /data/vendor/cashsvr/
rw_dir_file(vendor_cashsvr, vendor_cashsvr_data_file)
allow vendor_cashsvr vendor_cashsvr_data_file:file create_file_perms;

allow vendor_cashsvr input_device:dir search;
allow vendor_cashsvr input_device:chr_file r_file_perms;

allow vendor_cashsvr vendor_sysfs_input_name:file r_file_perms;
allow vendor_cashsvr vendor_sysfs_input_control:file { rw_file_perms setattr };

allow vendor_cashsvr vendor_sysfs_tof_sensor:file { rw_file_perms setattr };
allow vendor_cashsvr vendor_sysfs_rgbc_sensor:file { rw_file_perms setattr };

# Ignore overzealous probing
dontaudit vendor_cashsvr vendor_sysfs_msm_subsys:dir r_dir_perms;
dontaudit vendor_cashsvr vendor_sysfs_msm_subsys:file r_file_perms;
dontaudit vendor_cashsvr sysfs:dir r_dir_perms;
dontaudit vendor_cashsvr sysfs:file r_file_perms;
