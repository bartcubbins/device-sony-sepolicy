type adpl, domain;
type adpl_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(adpl)

set_prop(adpl, ctl_stop_prop)

allow adpl self:qipcrtr_socket create_socket_perms_no_ioctl;
allow adpl vendor_adpl_dpm_uds_socket:sock_file write;

allow adpl vendor_dpl_ctl_device:chr_file rw_file_perms;
allow adpl vendor_ipa_odl_ctl_device:chr_file rw_file_perms;

rw_vendor_diag_device(adpl)

r_dir_file(adpl, vendor_sysfs_esoc)
r_dir_file(adpl, vendor_sysfs_msm_subsys)
r_dir_file(adpl, vendor_sysfs_soc)
