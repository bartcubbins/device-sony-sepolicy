type qti, domain;
type qti_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(qti)

allow qti vendor_qti_dpm_uds_socket:sock_file write;
allow qti self:qipcrtr_socket create_socket_perms_no_ioctl;

allow qti vendor_dpl_ctl_device:chr_file rw_file_perms;
allow qti vendor_rmnet_device:chr_file rw_file_perms;

r_dir_file(qti, vendor_sysfs_esoc)
r_dir_file(qti, vendor_sysfs_msm_subsys)
r_dir_file(qti, vendor_sysfs_soc)

rw_vendor_diag_device(qti)

r_dir_file(qti, vendor_dataqti_data_file)
