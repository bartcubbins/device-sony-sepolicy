type vendor_rdclean, domain;
type vendor_rdclean_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_rdclean);

userdebug_or_eng(`
  allow vendor_rdclean vendor_ramdump_block_device:blk_file rw_file_perms;
  allow vendor_rdclean { vendor_shell_exec vendor_toolbox_exec }:file rx_file_perms;
  allow vendor_rdclean block_device:dir search;
')
