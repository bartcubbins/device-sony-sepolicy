type vendor_hal_gnss_qti, domain;
hal_server_domain(vendor_hal_gnss_qti, hal_gnss)

type vendor_hal_gnss_qti_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_gnss_qti)

r_dir_file(vendor_hal_gnss_qti, vendor_sysfs_msm_subsys)
r_dir_file(vendor_hal_gnss_qti, vendor_sysfs_esoc)

vndbinder_use(vendor_hal_gnss_qti)

hal_client_domain(vendor_hal_gnss_qti, hal_health)

allow vendor_hal_gnss_qti vendor_sysfs_soc:dir r_dir_perms;
allow vendor_hal_gnss_qti vendor_sysfs_soc:file r_file_perms;
allow vendor_hal_gnss_qti vendor_qmuxd_socket:dir w_dir_perms;
allow vendor_hal_gnss_qti vendor_qmuxd_socket:sock_file create_file_perms;
unix_socket_connect(vendor_hal_gnss_qti, vendor_qmuxd, qmuxd)

rw_vendor_diag_device(vendor_hal_gnss_qti)

binder_call(vendor_hal_gnss_qti, per_mgr)

get_prop(vendor_hal_gnss_qti, vendor_net_prop)

# /data/vendor/location
allow vendor_hal_gnss_qti vendor_location_data_file:fifo_file { open read setattr write };
allow vendor_hal_gnss_qti vendor_location_data_file:dir create_dir_perms;
allow vendor_hal_gnss_qti vendor_location_data_file:sock_file write;

qrtr_socket_create(vendor_hal_gnss_qti)

unix_socket_connect(vendor_hal_gnss_qti, vendor_netmgrd, netmgrd)
allow vendor_hal_gnss_qti vendor_netmgrd_socket:dir search;

allow vendor_hal_gnss_qti self:netlink_generic_socket { bind create read };
allow vendor_hal_gnss_qti self:netlink_route_socket { bind create nlmsg_read read write };

# Most HALs are not allowed to use network sockets. Qcom library
# libqdi is used across multiple processes which are clients of
# netmgrd including the GNSS HAL. libqdi first attempts to get the network
# interface using an IOCTL on a UDP INET socket, which isn't allowed here.
# If that fails, it falls back to using libc's if_nameindex() which requires
# a netlink route socket, which HALs may use. Due to the initial
# attempt to use a UDP socket, we still see a selinux denial,
# but it is safe to ignore.
# TODO (b/37730994) Remove udp_socket requirement from
# libqdi and have all its clients use netlink route
# sockets.
dontaudit vendor_hal_gnss_qti self:udp_socket create;

allow vendor_hal_gnss_qti kernel:system module_request;
