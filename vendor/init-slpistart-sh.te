type vendor_init-qcom-slpistart-sh, domain;
type vendor_init-qcom-slpistart-sh_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_init-qcom-slpistart-sh)

allow vendor_init-qcom-slpistart-sh { vendor_file vendor_shell_exec vendor_toolbox_exec }:file rx_file_perms;

# Set the vendor.qcom.slpiup property
set_prop(vendor_init-qcom-slpistart-sh, vendor_device_prop)

# Set boot_adsp, boot_cdsp and boot_slpi to 1
allow vendor_init-qcom-slpistart-sh vendor_sysfs_msm_subsys:file w_file_perms;

# Ignore O_CREAT flag in bash file redirection:
dontaudit vendor_init-qcom-slpistart-sh vendor_sysfs_msm_subsys:file create;
