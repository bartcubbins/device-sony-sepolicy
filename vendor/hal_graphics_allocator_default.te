r_dir_file(hal_graphics_allocator_default, vendor_sysfs_graphics)
r_dir_file(hal_graphics_allocator_default, vendor_sysfs_mdss_mdp_caps)
r_dir_file(hal_graphics_allocator_default, vendor_sysfs_msm_subsys)

# allow hal_graphics_allocator_default to read kgsl gpu model
allow hal_graphics_allocator_default vendor_sysfs_kgsl_gpu_model:file r_file_perms;

# Access to dma-buf devices
allow hal_graphics_allocator_default vendor_dmabuf_demura_heap_device:chr_file r_file_perms;
allow hal_graphics_allocator_default vendor_dmabuf_display_heap_device:chr_file r_file_perms;
allow hal_graphics_allocator_default vendor_dmabuf_secure_cdsp_heap_device:chr_file r_file_perms;
allow hal_graphics_allocator_default vendor_dmabuf_secure_pixel:chr_file r_file_perms;
allow hal_graphics_allocator_default vendor_dmabuf_system_heap_device:chr_file r_file_perms;
allow hal_graphics_allocator_default vendor_dmabuf_system_movable_heap_device:chr_file r_file_perms;
allow hal_graphics_allocator_default vendor_dmabuf_ubwcp_heap_device:chr_file r_file_perms;
allow hal_graphics_allocator_default vendor_dmabuf_ubwcp_movable_heap_device:chr_file r_file_perms;
