# Policy for the timekeep.c oneshot system service
# Gets called once during init by vendor timekeep.rc and restores
# clock from persist.vendor.timeadjust property, reads
# /sys/class/rtc/rtc0/since_epoch
type vendor_timekeep, domain;
type vendor_timekeep_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_timekeep)

# Grant permission to set system time and to set the real-time clock
allow vendor_timekeep self:capability sys_time;

# Write to /data/vendor/time/ats_2
allow vendor_timekeep vendor_timekeep_data_file:dir rw_dir_perms;
allow vendor_timekeep vendor_timekeep_data_file:file create_file_perms;

# Set persist.vendor.timeadjust
set_prop(vendor_timekeep, vendor_timekeep_prop)

# Read /sys/class/rtc/rtc0/since_epoch
allow vendor_timekeep sysfs_rtc:dir search;
allow vendor_timekeep sysfs_rtc:{ file lnk_file } r_file_perms;
# The open() call in timekeep.c will traverse parent folders
# of the target path as well to resolve the symlink.
allow vendor_timekeep vendor_sysfs_msm_subsys:dir search;
