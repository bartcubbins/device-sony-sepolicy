type vendor_init-qcom-ipastart-sh, domain;
type vendor_init-qcom-ipastart-sh_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_init-qcom-ipastart-sh)

allow vendor_init-qcom-ipastart-sh { vendor_shell_exec vendor_toolbox_exec }:file rx_file_perms;

# Set /dev/ipa to 1
allow vendor_init-qcom-ipastart-sh vendor_ipa_dev:chr_file w_file_perms;
