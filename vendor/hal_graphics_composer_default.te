# Connect to the allocator:
hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator)

# Binder access (for display.qservice)
vndbinder_use(hal_graphics_composer_default)

# HWC hosts the qdisplay and display config services:
add_service(hal_graphics_composer_default, vendor_qdisplay_service)
hal_attribute_hwservice(hal_graphics_composer, vendor_hal_display_config_hwservice)

allow hal_graphics_composer_default { graphics_device video_device }:chr_file rw_file_perms;
rw_vendor_diag_device(hal_graphics_composer_default)

allow hal_graphics_composer_default oemfs:dir search;
allow hal_graphics_composer_default vendor_persist_display_file:dir getattr;
allow hal_graphics_composer_default vendor_persist_file:dir search;

r_dir_rw_file(hal_graphics_composer_default, sysfs_leds)
r_dir_file(hal_graphics_composer_default, vendor_sysfs_camera)
r_dir_file(hal_graphics_composer_default, vendor_sysfs_msm_subsys)
allow hal_graphics_composer_default vendor_sysfs_mdss_mdp_caps:file r_file_perms;
# Access /sys/devices/virtual/graphics/fb0
r_dir_rw_file(hal_graphics_composer_default, vendor_sysfs_graphics)
# Access /mnt/vendor/persist/display
allow hal_graphics_composer_default mnt_vendor_file:dir search;
r_dir_file(hal_graphics_composer_default, vendor_persist_display_file)
# Access /data/vendor/display/
create_dir_file(hal_graphics_composer_default, vendor_display_data_file)

# Access to qfprom fuses
r_dir_file(hal_graphics_composer_default, vendor_sysfs_qfprom)

# HWC_UeventThread
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

# Allow access to qipcrtr_socket
allow hal_graphics_composer_default self:qipcrtr_socket create_socket_perms_no_ioctl;

# allow hal_graphics_composer_default to read kgsl gpu model
allow hal_graphics_composer_default vendor_sysfs_kgsl_gpu_model:file r_file_perms;

# Access to mem-buf devices
allow hal_graphics_composer_default vendor_membuf_dev:chr_file r_file_perms;
allow hal_graphics_composer_default vendor_vm_cp_pixel_device:chr_file r_file_perms;
allow hal_graphics_composer_default vendor_vm_hlos_device:chr_file r_file_perms;
allow hal_graphics_composer_default vendor_vm_trusted_device:chr_file r_file_perms;
